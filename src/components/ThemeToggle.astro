---
import Icon from './Icon.astro';
---

<button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch theme" aria-pressed="false">
  <span class="theme-toggle-icon theme-toggle-icon--sun"><Icon name="sun" size={18} /></span>
  <span class="theme-toggle-icon theme-toggle-icon--moon"><Icon name="moon" size={18} /></span>
</button>

<script>
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const getStoredTheme = () => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  };

  const updateButton = () => {
    if (!button) return;
    const isDark = root.dataset.theme === 'dark';
    button.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
    button.setAttribute('aria-pressed', String(isDark));
  };

  const setTheme = (theme: 'light' | 'dark', persist = true) => {
    root.dataset.theme = theme;
    if (persist) {
      try {
        localStorage.setItem('theme', theme);
      } catch {
        // Storage can be unavailable in private browsing contexts.
      }
    }
    updateButton();
    window.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
  };

  button?.addEventListener('click', () => {
    setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
  });

  media.addEventListener('change', (event) => {
    if (!getStoredTheme()) {
      setTheme(event.matches ? 'dark' : 'light', false);
    }
  });

  updateButton();
</script>